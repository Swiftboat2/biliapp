{
  "expo": {
    "name": "Instituto República de Italia",
    "slug": "republica-de-italia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-colegio.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-colegio.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.republicadeitalia.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-colegio.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ar.edu.republicadeitalia.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permiso para escanear credenciales y códigos QR en puerta y retiros."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#008C45"
        }
      ]
    ]
  }
}
